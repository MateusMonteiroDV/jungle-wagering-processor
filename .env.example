# Application
NODE_ENV=development
PORT=3001
INSTANCE_ID=app-local-1
LOG_LEVEL=info

# Feature Flags (process roles)
RUN_HTTP=true
RUN_CONSUMER=true
RUN_OUTBOX=true
RUN_PENDING=true
RUN_DLQ_METRICS=true

# PostgreSQL
DB_HOST=localhost
DB_PORT=5433
DB_USER=wagering
DB_PASSWORD=wagering_secret
DB_NAME=wagering
DB_LOCK_TIMEOUT_MS=5000
DB_STATEMENT_TIMEOUT_MS=10000
DB_POOL_MAX=20

# AWS / SQS (LocalStack)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
SQS_ENDPOINT=http://localhost:4566
SQS_WAGER_QUEUE_NAME=wager-transactions.fifo
SQS_WAGER_DLQ_NAME=wager-transactions-dlq.fifo
SQS_EVENTS_QUEUE_NAME=wallet-events.fifo
SQS_VISIBILITY_TIMEOUT_SEC=30
SQS_MAX_RECEIVE_COUNT=5
SQS_WAIT_TIME_SEC=5
SQS_CONSUMER_POLL_INTERVAL_MS=100
SQS_RETRY_BASE_SEC=2

# Workers
OUTBOX_POLL_INTERVAL_MS=500
OUTBOX_BATCH_SIZE=50
OUTBOX_LEASE_SEC=30

PENDING_REF_POLL_INTERVAL_MS=1000
PENDING_REF_BATCH_SIZE=50
PENDING_REF_MAX_ATTEMPTS=10
PENDING_REF_TTL_MS=900000
PENDING_REF_BASE_DELAY_MS=1000

DLQ_METRICS_POLL_INTERVAL_MS=15000
SHUTDOWN_GRACE_MS=20000

# Fault injection (tests only)
FAULT_INJECTION=
